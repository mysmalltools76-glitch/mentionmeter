# Google AI Studio se Gemini API key (https://aistudio.google.com)
GEMINI_API_KEY=

# Gemini model ka naam. AI Studio mein dekh lein kaunsa free model abhi available hai.
GEMINI_MODEL=gemini-2.5-flash

# "true" karein to Gemini Google Search use kar ke jawab dega (asal AI search ke qareeb).
# Free tier mein is ki alag limit ho sakti hai, is liye shuru mein false rakhein.
USE_GROUNDING=false

# Supabase project ka URL aur secret key (Project Settings -> API Keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Koi bhi lamba random text (IP address ko chhupa kar save karne ke liye)
IP_SALT=change-this-to-any-long-random-text

# Apni email(s), comma se alag. In par daily limit nahi lagegi (testing ke liye).
ADMIN_EMAILS=
